{
	"name": "@trioforge/spline",
	"version": "0.1.0",
	"description": "Catmull-Rom, cubic Bezier, and uniform B-spline curves for roblox-ts",
	"keywords": [
		"roblox",
		"roblox-ts",
		"spline",
		"catmull-rom",
		"bezier",
		"b-spline"
	],
	"homepage": "https://website.trio-forge.workers.dev/spline/",
	"bugs": "https://github.com/Trio-Forge-Studio/packages/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Trio-Forge-Studio/packages.git",
		"directory": "packages/spline"
	},
	"license": "MIT",
	"main": "out/init.luau",
	"types": "out/index.d.ts",
	"files": [
		"out",
		"!**/*.tsbuildinfo",
		"README.md",
		"LICENSE"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "rbxtsc --type package",
		"test": "rbxtsc --type package && lune run test",
		"check": "stylua --check test .lune && rbxtsc --type package && lune run test && node scripts/check-snippets.mjs README.md",
		"prepack": "rbxtsc --type package"
	},
	"devDependencies": {
		"@rbxts/compiler-types": "catalog:rbxts",
		"@rbxts/types": "catalog:rbxts",
		"roblox-ts": "catalog:rbxts",
		"typescript": "catalog:rbxts"
	}
}
